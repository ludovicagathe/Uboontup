# FUNCTIONS
gcom() { # git commit -am "YYYYmmddHHMM - Details"
  if [[ -z $1 ]]; then
    DETAILS="Work in progress"
  else
    DETAILS=$1
  fi
  git submodule update --remote --recursive
  git add .
  git commit -am "$(date +%Y%m%d%H%M) - $DETAILS"
}

gtag() { # git tag -a v1.4 -m "my version 1.4"
  local VERSION
  local MESSAGE
  if [[ -z "$1" ]];then
    echo "gtag: Verify and add tag to repo" >&2
    return 1
  fi
  if [[ "$1" =~ ^[v]?[0-9]+(\.[0-9]+)?{2,3}(\-([\.0-9a-zA-Z]+))?$ ]]; then
    VERSION="$1"
    if [[ "${1:0:1}" != "v" ]]; then
      VERSION="v""$VERSION"
    fi
  else
    echo "ERROR: Invalid arguments supplied to gtag. Version number 'v1.2.3' and (optional) 'message' to be supplied" >&2
    return 1
  fi
  if [[ ! -z $2 ]]; then
    git tag -a "$VERSION" -m "$2"
    return 0
  fi
  
  git tag "$VERSION"
  return 0
}

pvar(){ # Print the value of a variable
  if [[ -z $1 ]]; then
    echo "pvar: Verify and add variable name to print" >&2
    return 1
  fi
  ( set -o posix ; set ) | grep -iF "${!1}";
  return 0
}

# PATH inclusions
PATH="$PATH:$HOME/.local/bin"

# If not running in a terminal, launch tmux. Useful when using IDEs, to prevent TMUX from being launched when running in a terminal. This is a workaround for IDEs that do not support tmux, such as VSCode.
if [[ -z "${TERM_PROGRAM}" ]]; then
  [ -z "$TMUX" ] && [ -z "$TERM_PROGRAM" ] && tmux
fi