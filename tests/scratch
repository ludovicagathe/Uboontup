    local ERROR_MESSAGE=".bashrc file not found"
    echo -e "${RED}$ERROR_MESSAGE${NC}" >&2
    echo "Please check that you have Bash installed and configured correctly" >&2
    critical_error "$ERROR_MESSAGE"
